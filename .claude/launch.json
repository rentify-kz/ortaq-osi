{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "ortaq-prototype",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 5173,
      "cwd": "apps/prototype"
    },
    {
      "name": "ortaq-api",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 3000,
      "cwd": "apps/api"
    },
    {
      "name": "ortaq-web",
      "runtimeExecutable": "npm",
      "runtimeArgs": [
        "run",
        "dev"
      ],
      "port": 5174,
      "cwd": "apps/web"
    },
    {
      "name": "ortaq-mobile",
      "runtimeExecutable": "npx",
      "runtimeArgs": [
        "expo",
        "start",
        "--web",
        "--port",
        "8081"
      ],
      "port": 8081,
      "cwd": "apps/mobile",
      "env": {
        "BROWSER": "none",
        "EXPO_NO_TELEMETRY": "1"
      }
    }
  ]
}
