// Модель данных фазы 0. Полное описание — docs/02-data-model.md.
// Колонки и таблицы в snake_case: на них ссылаются политики RLS в миграциях.
// Миграции применяются ролью-владельцем (MIGRATE_DATABASE_URL); приложение работает под ortaq_app.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("MIGRATE_DATABASE_URL")
}

enum ManagementForm {
  OSI
  PT
}

enum OrganizationStatus {
  ACTIVE
  SUSPENDED
}

enum PaymentMode {
  RECEIPT
  KASPI_API
}

enum UnitType {
  APARTMENT
  COMMERCIAL
  PARKING
  STORAGE
}

enum UserStatus {
  PENDING
  ACTIVE
  BLOCKED
}

enum Locale {
  ru
  kk
}

enum HouseRole {
  CHAIRMAN
  ACCOUNTANT
  WORKER
  RESIDENT
}

enum MembershipStatus {
  PENDING
  ACTIVE
  REVOKED
}

enum JoinedVia {
  ADMIN_PROVISION
  INVITE_LINK
  JOIN_REQUEST
  CHAIRMAN_ADD
}

enum OwnershipRelation {
  OWNER
  TENANT
  FAMILY
}

enum VerificationStatus {
  PENDING
  VERIFIED
  REJECTED
}

enum VerificationMethod {
  EDS_REGISTRY_MATCH
  MANUAL_CHAIRMAN
}

enum InviteType {
  PUBLIC_LINK
  PERSONAL
}

enum JoinRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum AuthTokenPurpose {
  SET_PASSWORD
  RESET_PASSWORD
}

model Organization {
  id             String             @id @default(uuid(7)) @db.Uuid
  name           String
  bin            String             @unique @db.VarChar(12)
  managementForm ManagementForm     @map("management_form")
  legalAddress   String             @map("legal_address")
  bankDetails    Json?              @map("bank_details")
  status         OrganizationStatus @default(ACTIVE)
  createdAt      DateTime           @default(now()) @map("created_at") @db.Timestamptz
  updatedAt      DateTime           @updatedAt @map("updated_at") @db.Timestamptz
  houses         House[]

  @@map("organizations")
}

model House {
  id                 String       @id @default(uuid(7)) @db.Uuid
  organizationId     String       @map("organization_id") @db.Uuid
  organization       Organization @relation(fields: [organizationId], references: [id])
  address            String
  displayName        String       @map("display_name")
  entranceCount      Int          @map("entrance_count")
  unitCount          Int          @map("unit_count")
  floorCount         Int?         @map("floor_count")
  builtYear          Int?         @map("built_year")
  /// Сумма площадей помещений. Пересчитывается триггером, не вводится
  totalArea          Decimal      @default(0) @map("total_area") @db.Decimal(12, 2)
  /// true, когда у всех голосующих помещений есть площадь. Пересчитывается триггером
  isVotingReady      Boolean      @default(false) @map("is_voting_ready")
  registryUploadedAt DateTime?    @map("registry_uploaded_at") @db.Timestamptz
  paymentMode        PaymentMode  @default(RECEIPT) @map("payment_mode")
  kaspiConfig        Json?        @map("kaspi_config")
  timezone           String       @default("Asia/Almaty")
  createdAt          DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime     @updatedAt @map("updated_at") @db.Timestamptz

  units         Unit[]
  memberships   HouseMembership[]
  invites       Invite[]
  joinRequests  JoinRequest[]
  registry      OwnerRegistryEntry[]
  imports       RegistryImport[]
  announcements Announcement[]
  staff         StaffMember[]
  contractors   Contractor[]
  files         File[]
  requests      Request[]
  tasks         Task[]
  recurring     RecurringTaskTemplate[]

  /// Счётчик номеров заявок дома: «заявка №47». Увеличивается в той же транзакции, что и вставка
  requestSeq Int @default(0) @map("request_seq")

  @@index([organizationId])
  @@map("houses")
}

model Unit {
  id                   String   @id @default(uuid(7)) @db.Uuid
  houseId              String   @map("house_id") @db.Uuid
  house                House    @relation(fields: [houseId], references: [id])
  /// Текст, потому что бывают «12А» и «1/2»
  number               String
  type                 UnitType @default(APARTMENT)
  /// Площадь, м². Основа веса голоса. Пусто до заполнения
  area                 Decimal? @db.Decimal(8, 2)
  entrance             Int?
  floor                Int?
  rooms                Int?
  isExcludedFromVoting Boolean  @default(false) @map("is_excluded_from_voting")
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt            DateTime @updatedAt @map("updated_at") @db.Timestamptz

  ownerships UnitOwnership[]
  requests   Request[]

  @@unique([houseId, number])
  @@map("units")
}

model User {
  id                  String     @id @default(uuid(7)) @db.Uuid
  phone               String?    @unique @db.VarChar(16)
  email               String?    @unique @db.Citext
  passwordHash        String?    @map("password_hash")
  fullName            String     @map("full_name")
  iinEncrypted        Bytes?     @map("iin_encrypted")
  /// Один ИИН — одна учётная запись: иначе один человек голосует дважды
  iinHash             Bytes?     @unique @map("iin_hash")
  identityVerifiedAt  DateTime?  @map("identity_verified_at") @db.Timestamptz
  locale              Locale     @default(ru)
  /// TOTP-секрет, AES-256-GCM. Обязателен для админа, председателя, бухгалтера
  totpSecretEncrypted Bytes?     @map("totp_secret_encrypted")
  totpEnabledAt       DateTime?  @map("totp_enabled_at") @db.Timestamptz
  isPlatformAdmin     Boolean    @default(false) @map("is_platform_admin")
  status              UserStatus @default(PENDING)
  lastLoginAt         DateTime?  @map("last_login_at") @db.Timestamptz
  createdAt           DateTime   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime   @updatedAt @map("updated_at") @db.Timestamptz

  memberships       HouseMembership[]
  ownerships        UnitOwnership[]
  sessions          Session[]
  authTokens        AuthToken[]
  joinRequests      JoinRequest[]
  consents          Consent[]
  verifications     Verification[]
  devices           DeviceToken[]
  notifications     Notification[]
  notificationPrefs NotificationPreference[]
  requests          Request[]                @relation("RequestAuthor")
  tasks             Task[]                   @relation("TaskAssignee")

  @@map("users")
}

model HouseMembership {
  id        String           @id @default(uuid(7)) @db.Uuid
  userId    String           @map("user_id") @db.Uuid
  user      User             @relation(fields: [userId], references: [id])
  houseId   String           @map("house_id") @db.Uuid
  house     House            @relation(fields: [houseId], references: [id])
  role      HouseRole
  status    MembershipStatus @default(ACTIVE)
  joinedVia JoinedVia        @map("joined_via")
  createdAt DateTime         @default(now()) @map("created_at") @db.Timestamptz
  revokedAt DateTime?        @map("revoked_at") @db.Timestamptz

  // Уникальность (user_id, house_id) среди не отозванных — частичный индекс в миграции
  @@index([houseId, role])
  @@index([userId])
  @@map("house_memberships")
}

model UnitOwnership {
  id                     String              @id @default(uuid(7)) @db.Uuid
  houseId                String              @map("house_id") @db.Uuid
  unitId                 String              @map("unit_id") @db.Uuid
  unit                   Unit                @relation(fields: [unitId], references: [id])
  userId                 String              @map("user_id") @db.Uuid
  user                   User                @relation(fields: [userId], references: [id])
  relation               OwnershipRelation
  share                  Decimal             @default(1) @db.Decimal(5, 4)
  verificationStatus     VerificationStatus  @default(PENDING) @map("verification_status")
  verificationMethod     VerificationMethod? @map("verification_method")
  verifiedAt             DateTime?           @map("verified_at") @db.Timestamptz
  verifiedBy             String?             @map("verified_by") @db.Uuid
  /// Почему собственность ждёт председателя: нет в реестре, расхождение ФИО, причина отказа
  verificationNote       String?             @map("verification_note")
  isVotingRepresentative Boolean             @default(false) @map("is_voting_representative")
  createdAt              DateTime            @default(now()) @map("created_at") @db.Timestamptz

  @@unique([unitId, userId])
  @@index([houseId])
  @@map("unit_ownerships")
}

model Invite {
  id         String     @id @default(uuid(7)) @db.Uuid
  houseId    String     @map("house_id") @db.Uuid
  house      House      @relation(fields: [houseId], references: [id])
  /// SHA-256 от токена. Сам токен показывается один раз и не хранится
  tokenHash  Bytes      @unique @map("token_hash")
  type       InviteType
  targetRole HouseRole  @map("target_role")
  expiresAt  DateTime   @map("expires_at") @db.Timestamptz
  maxUses    Int?       @map("max_uses")
  useCount   Int        @default(0) @map("use_count")
  revokedAt  DateTime?  @map("revoked_at") @db.Timestamptz
  createdBy  String     @map("created_by") @db.Uuid
  createdAt  DateTime   @default(now()) @map("created_at") @db.Timestamptz

  @@index([houseId])
  @@map("invites")
}

model JoinRequest {
  id                String            @id @default(uuid(7)) @db.Uuid
  houseId           String            @map("house_id") @db.Uuid
  house             House             @relation(fields: [houseId], references: [id])
  userId            String            @map("user_id") @db.Uuid
  user              User              @relation(fields: [userId], references: [id])
  claimedUnitNumber String            @map("claimed_unit_number")
  claimedRelation   OwnershipRelation @map("claimed_relation")
  comment           String?
  status            JoinRequestStatus @default(PENDING)
  reviewedBy        String?           @map("reviewed_by") @db.Uuid
  reviewedAt        DateTime?         @map("reviewed_at") @db.Timestamptz
  rejectionReason   String?           @map("rejection_reason")
  createdAt         DateTime          @default(now()) @map("created_at") @db.Timestamptz

  @@index([houseId, status])
  @@map("join_requests")
}

/// Выданные refresh-токены. family_id связывает цепочку ротаций: повторное использование
/// отозванного токена означает кражу, и вся семья отзывается
model Session {
  id         String    @id @default(uuid(7)) @db.Uuid
  userId     String    @map("user_id") @db.Uuid
  user       User      @relation(fields: [userId], references: [id])
  tokenHash  Bytes     @unique @map("token_hash")
  familyId   String    @map("family_id") @db.Uuid
  deviceInfo String?   @map("device_info")
  ip         String?
  expiresAt  DateTime  @map("expires_at") @db.Timestamptz
  rotatedAt  DateTime? @map("rotated_at") @db.Timestamptz
  revokedAt  DateTime? @map("revoked_at") @db.Timestamptz
  createdAt  DateTime  @default(now()) @map("created_at") @db.Timestamptz

  @@index([familyId])
  @@index([userId])
  @@map("sessions")
}

/// Одноразовые токены из писем: установка и сброс пароля. Хранится только хеш
model AuthToken {
  id         String           @id @default(uuid(7)) @db.Uuid
  userId     String           @map("user_id") @db.Uuid
  user       User             @relation(fields: [userId], references: [id])
  tokenHash  Bytes            @unique @map("token_hash")
  purpose    AuthTokenPurpose
  expiresAt  DateTime         @map("expires_at") @db.Timestamptz
  consumedAt DateTime?        @map("consumed_at") @db.Timestamptz
  createdAt  DateTime         @default(now()) @map("created_at") @db.Timestamptz

  @@map("auth_tokens")
}

/// Журнал аудита. Append-only: у ortaq_app только INSERT и SELECT.
/// Хеш-цепочка отдельная для каждого дома и одна общая для действий вне дома
model AuditLog {
  id         String   @id @default(uuid(7)) @db.Uuid
  houseId    String?  @map("house_id") @db.Uuid
  actorId    String?  @map("actor_id") @db.Uuid
  actorRole  String?  @map("actor_role")
  action     String
  entityType String   @map("entity_type")
  entityId   String?  @map("entity_id")
  before     Json?
  after      Json?
  ip         String?
  userAgent  String?  @map("user_agent")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  seq        BigInt   @default(autoincrement())
  prevHash   Bytes?   @map("prev_hash")
  hash       Bytes

  @@index([houseId, seq])
  @@map("audit_log")
}

/**
 * ═════════════════════════ Фаза 1 ═════════════════════════
 */

enum OtpPurpose {
  LOGIN
}

enum ConsentKind {
  TERMS
  NOTIFICATIONS
  PERSONAL_DATA
}

enum SignaturePurpose {
  IDENTITY_VERIFICATION
  BALLOT
  PROTOCOL
  REPORT
}

enum VerificationState {
  PENDING
  SIGNED
  FAILED
  EXPIRED
}

enum RegistryImportStatus {
  PREVIEW
  APPLIED
  DISCARDED
}

enum AnnouncementAudience {
  ALL
  STAFF
  SPECIFIC_USERS
  ENTRANCE
}

enum Specialization {
  PLUMBER
  ELECTRICIAN
  CLEANER
  YARD_KEEPER
  HANDYMAN
  SECURITY
  ELEVATOR
  OTHER
}

enum NotificationPriority {
  CRITICAL
  HIGH
  NORMAL
  LOW
}

enum NotificationCategory {
  VOTES
  REQUESTS
  ANNOUNCEMENTS
  PAYMENTS
  REPORTS
  MEMBERSHIP
  SUMMARY
}

/// Одноразовый код из SMS. Хранится хешем, живёт 5 минут, не более 5 попыток
model OtpCode {
  id         String     @id @default(uuid(7)) @db.Uuid
  phone      String     @db.VarChar(16)
  codeHash   Bytes      @map("code_hash")
  purpose    OtpPurpose @default(LOGIN)
  attempts   Int        @default(0)
  ip         String?
  expiresAt  DateTime   @map("expires_at") @db.Timestamptz
  consumedAt DateTime?  @map("consumed_at") @db.Timestamptz
  createdAt  DateTime   @default(now()) @map("created_at") @db.Timestamptz

  @@index([phone, createdAt])
  @@index([ip, createdAt])
  @@map("otp_codes")
}

/// Согласия с версией текста. Отзыв не удаляет запись, а ставит revoked_at
model Consent {
  id          String      @id @default(uuid(7)) @db.Uuid
  userId      String      @map("user_id") @db.Uuid
  user        User        @relation(fields: [userId], references: [id])
  kind        ConsentKind
  version     String
  signatureId String?     @map("signature_id") @db.Uuid
  acceptedAt  DateTime    @default(now()) @map("accepted_at") @db.Timestamptz
  revokedAt   DateTime?   @map("revoked_at") @db.Timestamptz

  @@index([userId, kind])
  @@map("consents")
}

/// Подпись ЭЦП, проверенная сервером. Хранится всё, что понадобится при разбирательстве
model Signature {
  id                 String           @id @default(uuid(7)) @db.Uuid
  userId             String?          @map("user_id") @db.Uuid
  provider           String
  externalId         String           @map("external_id")
  purpose            SignaturePurpose
  documentHash       Bytes            @map("document_hash")
  signatureData      Bytes            @map("signature_data")
  signerIinHash      Bytes            @map("signer_iin_hash")
  signerFullName     String           @map("signer_full_name")
  certSerial         String           @map("cert_serial")
  certValidFrom      DateTime         @map("cert_valid_from") @db.Timestamptz
  certValidTo        DateTime         @map("cert_valid_to") @db.Timestamptz
  verifiedAt         DateTime         @map("verified_at") @db.Timestamptz
  verificationResult Json             @map("verification_result")
  createdAt          DateTime         @default(now()) @map("created_at") @db.Timestamptz

  @@unique([provider, externalId])
  @@map("signatures")
}

/// Процедура подтверждения личности: жилец подписывает согласие на обработку ПДн своей ЭЦП
model Verification {
  id           String            @id @default(uuid(7)) @db.Uuid
  userId       String            @map("user_id") @db.Uuid
  user         User              @relation(fields: [userId], references: [id])
  houseId      String?           @map("house_id") @db.Uuid
  provider     String
  externalId   String            @map("external_id")
  document     String
  documentHash Bytes             @map("document_hash")
  state        VerificationState @default(PENDING)
  signatureId  String?           @map("signature_id") @db.Uuid
  result       Json?
  expiresAt    DateTime          @map("expires_at") @db.Timestamptz
  createdAt    DateTime          @default(now()) @map("created_at") @db.Timestamptz
  completedAt  DateTime?         @map("completed_at") @db.Timestamptz

  @@index([userId])
  @@map("verifications")
}

/// Реестр собственников. ИИН только как HMAC: утечка таблицы не раскрывает номера
model OwnerRegistryEntry {
  id         String   @id @default(uuid(7)) @db.Uuid
  houseId    String   @map("house_id") @db.Uuid
  house      House    @relation(fields: [houseId], references: [id])
  unitNumber String   @map("unit_number")
  iinHash    Bytes    @map("iin_hash")
  fullName   String   @map("full_name")
  area       Decimal? @db.Decimal(8, 2)
  importId   String   @map("import_id") @db.Uuid
  importedAt DateTime @default(now()) @map("imported_at") @db.Timestamptz

  @@index([houseId, iinHash])
  @@index([houseId, unitNumber])
  @@map("owner_registry_entries")
}

/// Загрузка реестра: сначала превью с ошибками, применение — отдельным действием
model RegistryImport {
  id        String               @id @default(uuid(7)) @db.Uuid
  houseId   String               @map("house_id") @db.Uuid
  house     House                @relation(fields: [houseId], references: [id])
  fileName  String               @map("file_name")
  status    RegistryImportStatus @default(PREVIEW)
  /// Строки без ИИН: только хеш, ФИО, номер, площадь
  rows      Json
  issues    Json
  createdBy String               @map("created_by") @db.Uuid
  createdAt DateTime             @default(now()) @map("created_at") @db.Timestamptz
  appliedAt DateTime?            @map("applied_at") @db.Timestamptz

  @@index([houseId])
  @@map("registry_imports")
}

model Announcement {
  id          String               @id @default(uuid(7)) @db.Uuid
  houseId     String               @map("house_id") @db.Uuid
  house       House                @relation(fields: [houseId], references: [id])
  authorId    String               @map("author_id") @db.Uuid
  title       String
  body        String
  audience    AnnouncementAudience
  isPinned    Boolean              @default(false) @map("is_pinned")
  publishedAt DateTime             @default(now()) @map("published_at") @db.Timestamptz
  expiresAt   DateTime?            @map("expires_at") @db.Timestamptz
  deletedAt   DateTime?            @map("deleted_at") @db.Timestamptz
  targets     AnnouncementTarget[]
  reads       AnnouncementRead[]

  @@index([houseId, publishedAt])
  @@map("announcements")
}

model AnnouncementTarget {
  id             String       @id @default(uuid(7)) @db.Uuid
  houseId        String       @map("house_id") @db.Uuid
  announcementId String       @map("announcement_id") @db.Uuid
  announcement   Announcement @relation(fields: [announcementId], references: [id])
  userId         String?      @map("user_id") @db.Uuid
  entrance       Int?

  @@index([announcementId])
  @@map("announcement_targets")
}

model AnnouncementRead {
  houseId        String       @map("house_id") @db.Uuid
  announcementId String       @map("announcement_id") @db.Uuid
  announcement   Announcement @relation(fields: [announcementId], references: [id])
  userId         String       @map("user_id") @db.Uuid
  readAt         DateTime     @default(now()) @map("read_at") @db.Timestamptz

  @@id([announcementId, userId])
  @@map("announcement_reads")
}

model StaffMember {
  id                 String           @id @default(uuid(7)) @db.Uuid
  houseId            String           @map("house_id") @db.Uuid
  house              House            @relation(fields: [houseId], references: [id])
  userId             String?          @map("user_id") @db.Uuid
  fullName           String           @map("full_name")
  position           String
  specializations    Specialization[]
  phonePublic        String?          @map("phone_public") @db.VarChar(16)
  workSchedule       String?          @map("work_schedule")
  visibleToResidents Boolean          @default(true) @map("visible_to_residents")
  isActive           Boolean          @default(true) @map("is_active")
  createdAt          DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime         @updatedAt @map("updated_at") @db.Timestamptz

  @@index([houseId])
  @@map("staff_members")
}

model Contractor {
  id                 String           @id @default(uuid(7)) @db.Uuid
  houseId            String           @map("house_id") @db.Uuid
  house              House            @relation(fields: [houseId], references: [id])
  name               String
  bin                String?          @db.VarChar(12)
  specializations    Specialization[]
  contactPerson      String?          @map("contact_person")
  phone              String?          @db.VarChar(16)
  email              String?
  contractFrom       DateTime?        @map("contract_from") @db.Date
  contractTo         DateTime?        @map("contract_to") @db.Date
  visibleToResidents Boolean          @default(true) @map("visible_to_residents")
  isActive           Boolean          @default(true) @map("is_active")
  createdAt          DateTime         @default(now()) @map("created_at") @db.Timestamptz
  updatedAt          DateTime         @updatedAt @map("updated_at") @db.Timestamptz

  tasks Task[]

  @@index([houseId])
  @@map("contractors")
}

model DeviceToken {
  id         String   @id @default(uuid(7)) @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  user       User     @relation(fields: [userId], references: [id])
  token      String   @unique
  platform   String
  lastSeenAt DateTime @default(now()) @map("last_seen_at") @db.Timestamptz

  @@index([userId])
  @@map("device_tokens")
}

/// Уведомление и одновременно очередь отправки: scheduled_for сдвигается на утро в тихие часы
model Notification {
  id           String               @id @default(uuid(7)) @db.Uuid
  userId       String               @map("user_id") @db.Uuid
  user         User                 @relation(fields: [userId], references: [id])
  houseId      String?              @map("house_id") @db.Uuid
  category     NotificationCategory
  priority     NotificationPriority
  title        String
  body         String
  payload      Json?
  scheduledFor DateTime             @default(now()) @map("scheduled_for") @db.Timestamptz
  sentAt       DateTime?            @map("sent_at") @db.Timestamptz
  channels     String[]
  readAt       DateTime?            @map("read_at") @db.Timestamptz
  createdAt    DateTime             @default(now()) @map("created_at") @db.Timestamptz

  @@index([userId, createdAt])
  @@index([sentAt, scheduledFor])
  @@map("notifications")
}

/// Отключённые категории push. Голосования отключить нельзя: юридически значимое извещение
model NotificationPreference {
  userId   String               @map("user_id") @db.Uuid
  user     User                 @relation(fields: [userId], references: [id])
  category NotificationCategory
  push     Boolean

  @@id([userId, category])
  @@map("notification_preferences")
}

/**
 * ───────── фаза 2: файлы, заявки, задачи ─────────
 */

enum FilePurpose {
  REQUEST_PHOTO
  TASK_PHOTO
}

enum FileStatus {
  PENDING_UPLOAD
  READY
  REJECTED
}

enum ScanStatus {
  PENDING
  CLEAN
  INFECTED
}

enum RequestCategory {
  PLUMBING
  ELECTRICITY
  HEATING
  ELEVATOR
  CLEANING
  YARD
  FACADE
  ROOF
  BASEMENT
  TRASH
  SECURITY
  OTHER
}

enum LocationType {
  YARD
  ENTRANCE
  APARTMENT
  FACADE
  ROOF
  BASEMENT
  PARKING
  COMMON_AREA
}

enum Priority {
  CRITICAL
  HIGH
  NORMAL
  LOW
}

enum PrioritySetBy {
  AI_SUGGESTED
  CHAIRMAN
}

enum RequestStatus {
  NEW
  TRIAGE
  REJECTED
  ACCEPTED
  IN_PROGRESS
  DONE
  CANCELLED
}

enum StageStatus {
  PENDING
  IN_PROGRESS
  DONE
  SKIPPED
}

enum TaskStatus {
  ASSIGNED
  IN_PROGRESS
  SUBMITTED
  APPROVED
  REJECTED
  CANCELLED
  EXPIRED
}

enum TaskSource {
  MANUAL
  FROM_REQUEST
  FROM_VOICE
  RECURRING
}

enum AiJobType {
  REQUEST_TRIAGE
  REQUEST_SUGGEST
}

enum AiJobStatus {
  DONE
  FAILED
}

enum HumanDecision {
  ACCEPTED
  MODIFIED
  REJECTED
}

/// Файл в объектном хранилище. Прямого права на файл нет: оно наследуется от родителя (заявки, отчёта о работе)
model File {
  id           String      @id @default(uuid(7)) @db.Uuid
  houseId      String      @map("house_id") @db.Uuid
  house        House       @relation(fields: [houseId], references: [id])
  storageKey   String      @unique @map("storage_key")
  originalName String      @map("original_name")
  /// Определён по содержимому при проверке, а не по расширению или заявлению клиента
  mimeType     String      @map("mime_type")
  sizeBytes    Int         @map("size_bytes")
  contentHash  Bytes?      @map("content_hash")
  width        Int?
  height       Int?
  purpose      FilePurpose
  status       FileStatus  @default(PENDING_UPLOAD)
  scanStatus   ScanStatus  @default(PENDING) @map("scan_status")
  exifStripped Boolean     @default(false) @map("exif_stripped")
  uploadedBy   String      @map("uploaded_by") @db.Uuid
  /// К чему привязан: REQUEST, TASK_COMPLETION. До привязки файл видит только загрузивший
  parentType   String?     @map("parent_type")
  parentId     String?     @map("parent_id") @db.Uuid
  createdAt    DateTime    @default(now()) @map("created_at") @db.Timestamptz
  finalizedAt  DateTime?   @map("finalized_at") @db.Timestamptz

  @@index([houseId, parentType, parentId])
  @@map("files")
}

model Request {
  id               String          @id @default(uuid(7)) @db.Uuid
  houseId          String          @map("house_id") @db.Uuid
  house            House           @relation(fields: [houseId], references: [id])
  number           Int
  authorId         String          @map("author_id") @db.Uuid
  author           User            @relation("RequestAuthor", fields: [authorId], references: [id])
  title            String
  description      String
  category         RequestCategory
  locationType     LocationType    @map("location_type")
  locationEntrance Int?            @map("location_entrance")
  locationFloor    Int?            @map("location_floor")
  locationDetail   String?         @map("location_detail")
  unitId           String?         @map("unit_id") @db.Uuid
  unit             Unit?           @relation(fields: [unitId], references: [id])
  priority         Priority        @default(NORMAL)
  prioritySetBy    PrioritySetBy?  @map("priority_set_by")
  status           RequestStatus   @default(NEW)
  /// Результат триажа: осмысленность, приоритет, обоснование. Подсказка, а не решение
  aiTriage         Json?           @map("ai_triage")
  /// Пометки для председателя: NEEDS_CLARIFICATION, SUSPICIOUS, POSSIBLE_DUPLICATE, NO_AUTOCHECK
  triageFlags      String[]        @default([]) @map("triage_flags")
  duplicateOfId    String?         @map("duplicate_of_id") @db.Uuid
  duplicateOf      Request?        @relation("RequestDuplicates", fields: [duplicateOfId], references: [id])
  duplicates       Request[]       @relation("RequestDuplicates")
  rejectionReason  String?         @map("rejection_reason")
  photoFileIds     String[]        @default([]) @map("photo_file_ids") @db.Uuid
  rating           Int?
  ratingComment    String?         @map("rating_comment")
  acceptedAt       DateTime?       @map("accepted_at") @db.Timestamptz
  doneAt           DateTime?       @map("done_at") @db.Timestamptz
  deletedAt        DateTime?       @map("deleted_at") @db.Timestamptz
  createdAt        DateTime        @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime        @updatedAt @map("updated_at") @db.Timestamptz

  stages    RequestStage[]
  events    RequestEvent[]
  followers RequestFollower[]
  tasks     Task[]

  @@unique([houseId, number])
  @@index([houseId, status, priority])
  @@index([houseId, locationType, category])
  @@map("requests")
}

/// Этапы работы: прогресс заявки для жильца = доля завершённых этапов
model RequestStage {
  id          String      @id @default(uuid(7)) @db.Uuid
  houseId     String      @map("house_id") @db.Uuid
  requestId   String      @map("request_id") @db.Uuid
  request     Request     @relation(fields: [requestId], references: [id])
  order       Int
  title       String
  status      StageStatus @default(PENDING)
  completedAt DateTime?   @map("completed_at") @db.Timestamptz
  completedBy String?     @map("completed_by") @db.Uuid
  note        String?
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz

  tasks Task[]

  @@index([requestId, order])
  @@map("request_stages")
}

/// История заявки для экрана жильца. public = false — служебные события, только правлению
model RequestEvent {
  id        String   @id @default(uuid(7)) @db.Uuid
  houseId   String   @map("house_id") @db.Uuid
  requestId String   @map("request_id") @db.Uuid
  request   Request  @relation(fields: [requestId], references: [id])
  actorId   String?  @map("actor_id") @db.Uuid
  type      String
  data      Json?
  public    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([requestId, createdAt])
  @@map("request_events")
}

/// Жильцы, присоединившиеся к заявке-дубликату: «об этом уже сообщили — следить за решением»
model RequestFollower {
  houseId   String   @map("house_id") @db.Uuid
  requestId String   @map("request_id") @db.Uuid
  request   Request  @relation(fields: [requestId], references: [id])
  userId    String   @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@id([requestId, userId])
  @@map("request_followers")
}

model Task {
  id                  String                 @id @default(uuid(7)) @db.Uuid
  houseId             String                 @map("house_id") @db.Uuid
  house               House                  @relation(fields: [houseId], references: [id])
  assigneeId          String?                @map("assignee_id") @db.Uuid
  assignee            User?                  @relation("TaskAssignee", fields: [assigneeId], references: [id])
  contractorId        String?                @map("contractor_id") @db.Uuid
  contractor          Contractor?            @relation(fields: [contractorId], references: [id])
  requestId           String?                @map("request_id") @db.Uuid
  request             Request?               @relation(fields: [requestId], references: [id])
  stageId             String?                @map("stage_id") @db.Uuid
  stage               RequestStage?          @relation(fields: [stageId], references: [id])
  recurringTemplateId String?                @map("recurring_template_id") @db.Uuid
  recurringTemplate   RecurringTaskTemplate? @relation(fields: [recurringTemplateId], references: [id])
  /// Момент вхождения расписания: не даёт породить одну и ту же рутинную задачу дважды
  occurrenceAt        DateTime?              @map("occurrence_at") @db.Timestamptz
  title               String
  description         String?
  specialization      Specialization?
  priority            Priority               @default(NORMAL)
  dueAt               DateTime?              @map("due_at") @db.Timestamptz
  requiresPhoto       Boolean                @default(false) @map("requires_photo")
  status              TaskStatus             @default(ASSIGNED)
  source              TaskSource
  createdBy           String?                @map("created_by") @db.Uuid
  startedAt           DateTime?              @map("started_at") @db.Timestamptz
  closedAt            DateTime?              @map("closed_at") @db.Timestamptz
  createdAt           DateTime               @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime               @updatedAt @map("updated_at") @db.Timestamptz

  completions TaskCompletion[]

  @@unique([recurringTemplateId, occurrenceAt])
  @@index([houseId, status])
  @@index([assigneeId, status])
  @@map("tasks")
}

/// Отчёт о выполнении. Фото видны жильцам только после подтверждения председателем
model TaskCompletion {
  id                 String    @id @default(uuid(7)) @db.Uuid
  houseId            String    @map("house_id") @db.Uuid
  taskId             String    @map("task_id") @db.Uuid
  task               Task      @relation(fields: [taskId], references: [id])
  /// Ключ повтора от клиента: офлайн-очередь может прислать отчёт дважды
  clientKey          String?   @unique @map("client_key")
  completedBy        String    @map("completed_by") @db.Uuid
  note               String?
  photoFileIds       String[]  @default([]) @map("photo_file_ids") @db.Uuid
  completedAt        DateTime  @default(now()) @map("completed_at") @db.Timestamptz
  approvedBy         String?   @map("approved_by") @db.Uuid
  approvedAt         DateTime? @map("approved_at") @db.Timestamptz
  rejectionReason    String?   @map("rejection_reason")
  visibleToResidents Boolean   @default(false) @map("visible_to_residents")
  includeInReport    Boolean   @default(false) @map("include_in_report")

  @@index([taskId])
  @@map("task_completions")
}

/// Рутинная работа по расписанию RFC 5545: «каждый будний день», «первый понедельник месяца»
model RecurringTaskTemplate {
  id                String          @id @default(uuid(7)) @db.Uuid
  houseId           String          @map("house_id") @db.Uuid
  house             House           @relation(fields: [houseId], references: [id])
  title             String
  description       String?
  specialization    Specialization?
  defaultAssigneeId String?         @map("default_assignee_id") @db.Uuid
  rrule             String
  leadTimeHours     Int             @default(12) @map("lead_time_hours")
  requiresPhoto     Boolean         @default(false) @map("requires_photo")
  isActive          Boolean         @default(true) @map("is_active")
  createdBy         String          @map("created_by") @db.Uuid
  createdAt         DateTime        @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime        @updatedAt @map("updated_at") @db.Timestamptz

  tasks Task[]

  @@index([houseId, isActive])
  @@map("recurring_task_templates")
}

/// Каждый вызов модели. Вход — ссылка на сущность, не текст; human_decision — оценка полезности ИИ
model AiJob {
  id            String         @id @default(uuid(7)) @db.Uuid
  houseId       String?        @map("house_id") @db.Uuid
  type          AiJobType
  provider      String
  model         String
  inputRef      Json           @map("input_ref")
  output        Json?
  status        AiJobStatus
  latencyMs     Int?           @map("latency_ms")
  error         String?
  humanDecision HumanDecision? @map("human_decision")
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz

  @@index([houseId, type, createdAt])
  @@map("ai_jobs")
}
