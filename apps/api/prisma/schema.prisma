// Модель данных фазы 0. Источник: docs/spec/02-data-model.md.
// Поля в snake_case совпадают с контрактом API. ID — UUIDv7, генерируются Prisma на стороне приложения.
// Политики RLS, роли и триггеры — в SQL миграций (Prisma их не описывает).

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  // Миграции выполняются владельцем схемы; приложение подключается ролями app_rw / app_admin.
  url      = env("DATABASE_MIGRATOR_URL")
}

enum ManagementForm {
  OSI
  PT
}

enum OrganizationStatus {
  ACTIVE
  SUSPENDED
}

enum PaymentMode {
  RECEIPT
  KASPI_API
}

enum UnitType {
  APARTMENT
  COMMERCIAL
  PARKING
  STORAGE
}

enum UserStatus {
  PENDING
  ACTIVE
  BLOCKED
}

enum Locale {
  ru
  kk
}

enum HouseRole {
  CHAIRMAN
  ACCOUNTANT
  WORKER
  RESIDENT
}

enum MembershipStatus {
  PENDING
  ACTIVE
  REVOKED
}

enum JoinedVia {
  ADMIN_PROVISION
  INVITE_LINK
  JOIN_REQUEST
  CHAIRMAN_ADD
}

enum InviteType {
  PUBLIC_LINK
  PERSONAL
}

enum InviteRole {
  RESIDENT
  WORKER
}

enum OwnershipRelation {
  OWNER
  TENANT
  FAMILY
}

enum JoinRequestStatus {
  PENDING
  APPROVED
  REJECTED
}

enum SessionClient {
  WEB
  MOBILE
}

enum ActionTokenPurpose {
  PASSWORD_SET
  PASSWORD_RESET
}

enum OtpPurpose {
  LOGIN
  STEP_UP
}

enum ScanStatus {
  PENDING
  CLEAN
  INFECTED
}

enum CounterKind {
  REQUEST
  PROTOCOL
  CONTRACT
}

model Organization {
  id              String             @id @default(uuid(7)) @db.Uuid
  name            String
  bin             String             @unique @db.VarChar(12)
  management_form ManagementForm
  legal_address   String
  bank_details    Json?
  status          OrganizationStatus @default(ACTIVE)
  created_at      DateTime           @default(now()) @db.Timestamptz(6)
  updated_at      DateTime           @updatedAt @db.Timestamptz(6)

  houses House[]

  @@map("organization")
}

model House {
  id                   String      @id @default(uuid(7)) @db.Uuid
  organization_id      String      @db.Uuid
  address              String
  display_name         String
  entrance_count       Int
  unit_count           Int
  floor_count          Int?
  built_year           Int?
  /// Вычисляется триггером из площадей помещений.
  total_area           Decimal?    @db.Decimal(12, 2)
  /// Вычисляется триггером: у всех участвующих в голосовании помещений заполнена площадь.
  is_voting_ready      Boolean     @default(false)
  registry_uploaded_at DateTime?   @db.Timestamptz(6)
  payment_mode         PaymentMode @default(RECEIPT)
  kaspi_config         Json?
  timezone             String      @default("Asia/Almaty")
  cadastral_number     String?
  address_rka          String?
  created_at           DateTime    @default(now()) @db.Timestamptz(6)
  updated_at           DateTime    @updatedAt @db.Timestamptz(6)

  organization Organization      @relation(fields: [organization_id], references: [id])
  units        Unit[]
  memberships  HouseMembership[]
  invites      Invite[]
  join_requests JoinRequest[]
  counters     HouseCounter[]

  @@index([organization_id])
  @@map("house")
}

model Unit {
  id                      String   @id @default(uuid(7)) @db.Uuid
  house_id                String   @db.Uuid
  /// Текст: бывают «12А», «1/2».
  number                  String
  type                    UnitType @default(APARTMENT)
  /// Площадь, м². Основа веса голоса. Nullable до заполнения.
  area                    Decimal? @db.Decimal(8, 2)
  entrance                Int?
  floor                   Int?
  rooms                   Int?
  is_excluded_from_voting Boolean  @default(false)
  created_at              DateTime @default(now()) @db.Timestamptz(6)
  updated_at              DateTime @updatedAt @db.Timestamptz(6)

  house House @relation(fields: [house_id], references: [id])

  @@unique([house_id, number])
  @@map("unit")
}

model User {
  id                    String     @id @default(uuid(7)) @db.Uuid
  /// E.164. Вход жильцов и работников.
  phone                 String?    @unique @db.VarChar(16)
  /// Вход админа, председателя, бухгалтера.
  email                 String?    @unique @db.Citext
  password_hash         String?
  password_changed_at   DateTime?  @db.Timestamptz(6)
  full_name             String
  iin_encrypted         Bytes?
  iin_hash              Bytes?     @unique
  identity_verified_at  DateTime?  @db.Timestamptz(6)
  avatar_file_id        String?    @db.Uuid
  locale                Locale     @default(ru)
  totp_secret_encrypted Bytes?
  totp_enabled_at       DateTime?  @db.Timestamptz(6)
  /// Последний принятый шаг TOTP: один код нельзя использовать дважды.
  totp_last_step        Int?
  status                UserStatus @default(PENDING)
  is_platform_admin     Boolean    @default(false)
  last_login_at         DateTime?  @db.Timestamptz(6)
  created_at            DateTime   @default(now()) @db.Timestamptz(6)
  updated_at            DateTime   @updatedAt @db.Timestamptz(6)

  memberships   HouseMembership[] @relation("membership_user")
  sessions      Session[]
  action_tokens ActionToken[]

  @@map("user")
}

model HouseMembership {
  id         String           @id @default(uuid(7)) @db.Uuid
  user_id    String           @db.Uuid
  house_id   String           @db.Uuid
  role       HouseRole
  status     MembershipStatus @default(ACTIVE)
  joined_via JoinedVia
  created_by String?          @db.Uuid
  created_at DateTime         @default(now()) @db.Timestamptz(6)
  revoked_at DateTime?        @db.Timestamptz(6)

  user  User  @relation("membership_user", fields: [user_id], references: [id])
  house House @relation(fields: [house_id], references: [id])

  // Частичный уникальный индекс (user_id, house_id) WHERE status = 'ACTIVE' — в SQL миграции.
  @@index([house_id, role, status])
  @@index([user_id, status])
  @@map("house_membership")
}

model Invite {
  id          String     @id @default(uuid(7)) @db.Uuid
  house_id    String     @db.Uuid
  /// SHA-256 от токена. Сам токен не хранится.
  token_hash  Bytes      @unique
  type        InviteType
  target_role InviteRole
  expires_at  DateTime   @db.Timestamptz(6)
  max_uses    Int?
  use_count   Int        @default(0)
  revoked_at  DateTime?  @db.Timestamptz(6)
  created_by  String     @db.Uuid
  created_at  DateTime   @default(now()) @db.Timestamptz(6)

  house House @relation(fields: [house_id], references: [id])

  @@index([house_id])
  @@map("invite")
}

model JoinRequest {
  id                  String            @id @default(uuid(7)) @db.Uuid
  house_id            String            @db.Uuid
  user_id             String            @db.Uuid
  claimed_unit_number String
  claimed_relation    OwnershipRelation
  comment             String?
  status              JoinRequestStatus @default(PENDING)
  reviewed_by         String?           @db.Uuid
  reviewed_at         DateTime?         @db.Timestamptz(6)
  rejection_reason    String?
  created_at          DateTime          @default(now()) @db.Timestamptz(6)

  house House @relation(fields: [house_id], references: [id])

  @@index([house_id, status])
  @@map("join_request")
}

model Session {
  id             String        @id @default(uuid(7)) @db.Uuid
  user_id        String        @db.Uuid
  /// Цепочка ротации refresh-токена. Повторное использование отозванного токена отзывает всю семью.
  family_id      String        @db.Uuid
  token_hash     Bytes         @unique
  client         SessionClient
  device_info    String?
  ip             String?
  expires_at     DateTime      @db.Timestamptz(6)
  revoked_at     DateTime?     @db.Timestamptz(6)
  replaced_by_id String?       @db.Uuid
  created_at     DateTime      @default(now()) @db.Timestamptz(6)

  user User @relation(fields: [user_id], references: [id])

  @@index([family_id])
  @@index([user_id])
  @@map("session")
}

model OtpCode {
  id          String     @id @default(uuid(7)) @db.Uuid
  phone       String     @db.VarChar(16)
  code_hash   Bytes
  purpose     OtpPurpose
  attempts    Int        @default(0)
  expires_at  DateTime   @db.Timestamptz(6)
  consumed_at DateTime?  @db.Timestamptz(6)
  created_at  DateTime   @default(now()) @db.Timestamptz(6)

  @@index([phone, purpose, created_at])
  @@map("otp_code")
}

/// Одноразовые токены из писем: установка и сброс пароля.
model ActionToken {
  id         String             @id @default(uuid(7)) @db.Uuid
  user_id    String             @db.Uuid
  purpose    ActionTokenPurpose
  token_hash Bytes              @unique
  expires_at DateTime           @db.Timestamptz(6)
  used_at    DateTime?          @db.Timestamptz(6)
  created_at DateTime           @default(now()) @db.Timestamptz(6)

  user User @relation(fields: [user_id], references: [id])

  @@index([user_id, purpose])
  @@map("action_token")
}

model HouseCounter {
  house_id String      @db.Uuid
  kind     CounterKind
  value    Int         @default(0)

  house House @relation(fields: [house_id], references: [id])

  @@id([house_id, kind])
  @@map("house_counter")
}

model File {
  id            String     @id @default(uuid(7)) @db.Uuid
  house_id      String?    @db.Uuid
  storage_key   String     @unique
  original_name String
  mime_type     String
  size_bytes    BigInt
  content_hash  Bytes
  uploaded_by   String     @db.Uuid
  scan_status   ScanStatus @default(PENDING)
  exif_stripped Boolean    @default(false)
  created_at    DateTime   @default(now()) @db.Timestamptz(6)

  @@index([house_id])
  @@map("file")
}

/// Append-only. prev_hash, hash, seq и created_at выставляет триггер БД.
model AuditLog {
  id          String   @id @default(uuid(7)) @db.Uuid
  seq         BigInt   @unique @default(0)
  house_id    String?  @db.Uuid
  actor_id    String?  @db.Uuid
  actor_role  String?
  action      String
  entity_type String
  entity_id   String?  @db.Uuid
  before      Json?
  after       Json?
  ip          String?
  user_agent  String?
  prev_hash   Bytes?
  hash        Bytes    @default(dbgenerated("'\\x'::bytea"))
  created_at  DateTime @default(now()) @db.Timestamptz(6)

  @@index([house_id, created_at(sort: Desc)])
  @@index([entity_type, entity_id])
  @@map("audit_log")
}

model IdempotencyKey {
  key          String   @id
  user_id      String   @db.Uuid
  endpoint     String
  request_hash Bytes
  response     Json
  status_code  Int
  created_at   DateTime @default(now()) @db.Timestamptz(6)
  expires_at   DateTime @db.Timestamptz(6)

  @@map("idempotency_key")
}
