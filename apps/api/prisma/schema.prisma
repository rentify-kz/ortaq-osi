  FAILED
}

enum HumanDecision {
  ACCEPTED
  MODIFIED
  REJECTED
}

/// Файл в объектном хранилище. Прямого права на файл нет: оно наследуется от родителя (заявки, отчёта о работе)
model File {
  id           String      @id @default(uuid(7)) @db.Uuid
  houseId      String      @map("house_id") @db.Uuid
  house        House       @relation(fields: [houseId], references: [id])
  storageKey   String      @unique @map("storage_key")
  originalName String      @map("original_name")
  /// Определён по содержимому при проверке, а не по расширению или заявлению клиента
  mimeType     String      @map("mime_type")
  sizeBytes    Int         @map("size_bytes")
  contentHash  Bytes?      @map("content_hash")
  width        Int?
  height       Int?
  purpose      FilePurpose
  status       FileStatus  @default(PENDING_UPLOAD)
  scanStatus   ScanStatus  @default(PENDING) @map("scan_status")
  exifStripped Boolean     @default(false) @map("exif_stripped")
  uploadedBy   String      @map("uploaded_by") @db.Uuid
  /// К чему привязан: REQUEST, TASK_COMPLETION. До привязки файл видит только загрузивший
  parentType   String?     @map("parent_type")
  parentId     String?     @map("parent_id") @db.Uuid
  createdAt    DateTime    @default(now()) @map("created_at") @db.Timestamptz
  finalizedAt  DateTime?   @map("finalized_at") @db.Timestamptz

  @@index([houseId, parentType, parentId])
  @@map("files")
}

model Request {
  id               String          @id @default(uuid(7)) @db.Uuid
  houseId          String          @map("house_id") @db.Uuid
  house            House           @relation(fields: [houseId], references: [id])
  number           Int
  authorId         String          @map("author_id") @db.Uuid
  author           User            @relation("RequestAuthor", fields: [authorId], references: [id])
  title            String
  description      String
  category         RequestCategory
  locationType     LocationType    @map("location_type")
  locationEntrance Int?            @map("location_entrance")
  locationFloor    Int?            @map("location_floor")
  locationDetail   String?         @map("location_detail")
  unitId           String?         @map("unit_id") @db.Uuid
  unit             Unit?           @relation(fields: [unitId], references: [id])
  priority         Priority        @default(NORMAL)
  prioritySetBy    PrioritySetBy?  @map("priority_set_by")
  status           RequestStatus   @default(NEW)
  /// Результат триажа: осмысленность, приоритет, обоснование. Подсказка, а не решение
  aiTriage         Json?           @map("ai_triage")
  /// Пометки для председателя: NEEDS_CLARIFICATION, SUSPICIOUS, POSSIBLE_DUPLICATE, NO_AUTOCHECK
  triageFlags      String[]        @default([]) @map("triage_flags")
  duplicateOfId    String?         @map("duplicate_of_id") @db.Uuid
  duplicateOf      Request?        @relation("RequestDuplicates", fields: [duplicateOfId], references: [id])
  duplicates       Request[]       @relation("RequestDuplicates")
  rejectionReason  String?         @map("rejection_reason")
  photoFileIds     String[]        @default([]) @map("photo_file_ids") @db.Uuid
  rating           Int?
  ratingComment    String?         @map("rating_comment")
  acceptedAt       DateTime?       @map("accepted_at") @db.Timestamptz
  doneAt           DateTime?       @map("done_at") @db.Timestamptz
  deletedAt        DateTime?       @map("deleted_at") @db.Timestamptz
  createdAt        DateTime        @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime        @updatedAt @map("updated_at") @db.Timestamptz

  stages    RequestStage[]
  events    RequestEvent[]
  followers RequestFollower[]
  tasks     Task[]

  @@unique([houseId, number])
  @@index([houseId, status, priority])
  @@index([houseId, locationType, category])
  @@map("requests")
}

/// Этапы работы: прогресс заявки для жильца = доля завершённых этапов
model RequestStage {
  id          String      @id @default(uuid(7)) @db.Uuid
  houseId     String      @map("house_id") @db.Uuid
  requestId   String      @map("request_id") @db.Uuid
  request     Request     @relation(fields: [requestId], references: [id])
  order       Int
  title       String
  status      StageStatus @default(PENDING)
  completedAt DateTime?   @map("completed_at") @db.Timestamptz
  completedBy String?     @map("completed_by") @db.Uuid
  note        String?
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz

  tasks Task[]

  @@index([requestId, order])
  @@map("request_stages")
}

/// История заявки для экрана жильца. public = false — служебные события, только правлению
model RequestEvent {
  id        String   @id @default(uuid(7)) @db.Uuid
  houseId   String   @map("house_id") @db.Uuid
  requestId String   @map("request_id") @db.Uuid
  request   Request  @relation(fields: [requestId], references: [id])
  actorId   String?  @map("actor_id") @db.Uuid
  type      String
  data      Json?
  public    Boolean  @default(true)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@index([requestId, createdAt])
  @@map("request_events")
}

/// Жильцы, присоединившиеся к заявке-дубликату: «об этом уже сообщили — следить за решением»
model RequestFollower {
  houseId   String   @map("house_id") @db.Uuid
  requestId String   @map("request_id") @db.Uuid
  request   Request  @relation(fields: [requestId], references: [id])
  userId    String   @map("user_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@id([requestId, userId])
  @@map("request_followers")
}

model Task {
  id                  String                 @id @default(uuid(7)) @db.Uuid
  houseId             String                 @map("house_id") @db.Uuid
  house               House                  @relation(fields: [houseId], references: [id])
  assigneeId          String?                @map("assignee_id") @db.Uuid
  assignee            User?                  @relation("TaskAssignee", fields: [assigneeId], references: [id])
  contractorId        String?                @map("contractor_id") @db.Uuid
  contractor          Contractor?            @relation(fields: [contractorId], references: [id])
  requestId           String?                @map("request_id") @db.Uuid
  request             Request?               @relation(fields: [requestId], references: [id])
  stageId             String?                @map("stage_id") @db.Uuid
  stage               RequestStage?          @relation(fields: [stageId], references: [id])
  recurringTemplateId String?                @map("recurring_template_id") @db.Uuid
  recurringTemplate   RecurringTaskTemplate? @relation(fields: [recurringTemplateId], references: [id])
  /// Момент вхождения расписания: не даёт породить одну и ту же рутинную задачу дважды
  occurrenceAt        DateTime?              @map("occurrence_at") @db.Timestamptz
  title               String
  description         String?
  specialization      Specialization?
  priority            Priority               @default(NORMAL)
  dueAt               DateTime?              @map("due_at") @db.Timestamptz
  requiresPhoto       Boolean                @default(false) @map("requires_photo")
  status              TaskStatus             @default(ASSIGNED)
  source              TaskSource
  createdBy           String?                @map("created_by") @db.Uuid
  startedAt           DateTime?              @map("started_at") @db.Timestamptz
  closedAt            DateTime?              @map("closed_at") @db.Timestamptz
  createdAt           DateTime               @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime               @updatedAt @map("updated_at") @db.Timestamptz

  completions TaskCompletion[]

  @@unique([recurringTemplateId, occurrenceAt])
  @@index([houseId, status])
  @@index([assigneeId, status])
  @@map("tasks")
}

/// Отчёт о выполнении. Фото видны жильцам только после подтверждения председателем
model TaskCompletion {
  id                 String    @id @default(uuid(7)) @db.Uuid
  houseId            String    @map("house_id") @db.Uuid
  taskId             String    @map("task_id") @db.Uuid
  task               Task      @relation(fields: [taskId], references: [id])
  /// Ключ повтора от клиента: офлайн-очередь может прислать отчёт дважды
  clientKey          String?   @unique @map("client_key")
  completedBy        String    @map("completed_by") @db.Uuid
  note               String?
  photoFileIds       String[]  @default([]) @map("photo_file_ids") @db.Uuid
  completedAt        DateTime  @default(now()) @map("completed_at") @db.Timestamptz
  approvedBy         String?   @map("approved_by") @db.Uuid
  approvedAt         DateTime? @map("approved_at") @db.Timestamptz
  rejectionReason    String?   @map("rejection_reason")
  visibleToResidents Boolean   @default(false) @map("visible_to_residents")
  includeInReport    Boolean   @default(false) @map("include_in_report")

  @@index([taskId])
  @@map("task_completions")
}

/// Рутинная работа по расписанию RFC 5545: «каждый будний день», «первый понедельник месяца»
model RecurringTaskTemplate {
  id                String          @id @default(uuid(7)) @db.Uuid
  houseId           String          @map("house_id") @db.Uuid
  house             House           @relation(fields: [houseId], references: [id])
  title             String
  description       String?
  specialization    Specialization?
  defaultAssigneeId String?         @map("default_assignee_id") @db.Uuid
  rrule             String
  leadTimeHours     Int             @default(12) @map("lead_time_hours")
  requiresPhoto     Boolean         @default(false) @map("requires_photo")
  isActive          Boolean         @default(true) @map("is_active")
  createdBy         String          @map("created_by") @db.Uuid
  createdAt         DateTime        @default(now()) @map("created_at") @db.Timestamptz
  updatedAt         DateTime        @updatedAt @map("updated_at") @db.Timestamptz

  tasks Task[]

  @@index([houseId, isActive])
  @@map("recurring_task_templates")
}

/// Каждый вызов модели. Вход — ссылка на сущность, не текст; human_decision — оценка полезности ИИ
model AiJob {
  id            String         @id @default(uuid(7)) @db.Uuid
  houseId       String?        @map("house_id") @db.Uuid
  type          AiJobType
  provider      String
  model         String
  inputRef      Json           @map("input_ref")
  output        Json?
  status        AiJobStatus
  latencyMs     Int?           @map("latency_ms")
  error         String?
  humanDecision HumanDecision? @map("human_decision")
  createdAt     DateTime       @default(now()) @map("created_at") @db.Timestamptz

  @@index([houseId, type, createdAt])
  @@map("ai_jobs")
}

// ───────── Фаза 3: финансы (docs/10, docs/02 §8) ─────────

enum BudgetSection {
  BALANCE
  INCOME
  EXPENSE
}

enum AccountType {
  CURRENT
  SAVINGS
}

enum TxDirection {
  IN
  OUT
}

enum TransactionStatus {
  DRAFT
  CONFIRMED
  VOIDED
}

enum DocumentKind {
  RECEIPT
  PAYMENT_ORDER
  WORK_ACT
  DEFECT_ACT
  CONTRACT
  PROTOCOL
  OTHER
}

/// План счетов = строки официальной формы отчёта. Глобальный, наполняется миграцией
model BudgetCategory {
  code                     String           @id @db.VarChar(10)
  parentCode               String?          @map("parent_code") @db.VarChar(10)
  parent                   BudgetCategory?  @relation("BudgetTree", fields: [parentCode], references: [code])
  children                 BudgetCategory[] @relation("BudgetTree")
  section                  BudgetSection
  order                    Int
  /// Формулировка из приказа
  nameRu                   String           @map("name_ru")
  nameKk                   String?          @map("name_kk")
  /// Короткое имя для интерфейса: «Обслуживание лифтов»
  shortName                String           @map("short_name")
  /// Можно ли проводить операции на этот код
  isLeaf                   Boolean          @map("is_leaf")
  /// false — наша детализация строки, которая в форме идёт без номера («в том числе: за услуги по …»)
  inForm                   Boolean          @map("in_form")
  allowedAccounts          AccountType[]    @map("allowed_accounts")
  requiresContractor       Boolean          @default(false) @map("requires_contractor")
  requiresAssemblyDecision Boolean          @default(false) @map("requires_assembly_decision")
  /// Документы сверх чека или платёжки, без которых строка отчёта считается неподтверждённой
  requiredDocuments        DocumentKind[]   @map("required_documents")
  formVersion              String           @map("form_version")

  transactions Transaction[]

  @@map("budget_categories")
}

model FinanceAccount {
  id                  String        @id @default(uuid(7)) @db.Uuid
  houseId             String        @map("house_id") @db.Uuid
  house               House         @relation(fields: [houseId], references: [id])
  type                AccountType
  bankName            String        @map("bank_name")
  /// Только последние 4 цифры: полный счёт в системе не нужен и не хранится
  accountNumberMasked String?       @map("account_number_masked")
  openingBalance      Decimal       @default(0) @map("opening_balance") @db.Decimal(14, 2)
  /// Дата, на которую известен начальный остаток; операции раньше неё не принимаются
  openedOn            DateTime      @map("opened_on") @db.Date
  createdAt           DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt           DateTime      @updatedAt @map("updated_at") @db.Timestamptz
  transactions        Transaction[]

  @@unique([houseId, type])
  @@map("finance_accounts")
}

/// Проведённая операция не меняется и не удаляется — это держит триггер в базе, а не только сервис
model Transaction {
  id             String                @id @default(uuid(7)) @db.Uuid
  houseId        String                @map("house_id") @db.Uuid
  house          House                 @relation(fields: [houseId], references: [id])
  number         Int
  accountId      String                @map("account_id") @db.Uuid
  account        FinanceAccount        @relation(fields: [accountId], references: [id])
  categoryCode   String                @map("category_code") @db.VarChar(10)
  category       BudgetCategory        @relation(fields: [categoryCode], references: [code])
  direction      TxDirection
  amount         Decimal               @db.Decimal(14, 2)
  occurredOn     DateTime              @map("occurred_on") @db.Date
  /// YYYY-MM: отчётный месяц, может отличаться от даты операции
  period         String                @db.VarChar(7)
  description    String
  contractorId   String?               @map("contractor_id") @db.Uuid
  contractor     Contractor?           @relation(fields: [contractorId], references: [id])
  /// Плательщик или получатель, если это не подрядчик из справочника: «Казахтелеком», «Аренда 1 этажа»
  counterparty   String?
  status         TransactionStatus     @default(DRAFT)
  idempotencyKey String                @map("idempotency_key")
  /// SHA-256 тела запроса: тот же ключ с другим телом — конфликт, а не тихий повтор
  requestHash    Bytes                 @map("request_hash")
  createdBy      String                @map("created_by") @db.Uuid
  createdAt      DateTime              @default(now()) @map("created_at") @db.Timestamptz
  confirmedBy    String?               @map("confirmed_by") @db.Uuid
  confirmedAt    DateTime?             @map("confirmed_at") @db.Timestamptz
  voidedBy       String?               @map("voided_by") @db.Uuid
  voidedAt       DateTime?             @map("voided_at") @db.Timestamptz
  voidReason     String?               @map("void_reason")
  /// Исправленная запись указывает на аннулированную: в журнале видно, что чем заменено
  correctsId     String?               @unique @map("corrects_id") @db.Uuid
  corrects       Transaction?          @relation("Correction", fields: [correctsId], references: [id])
  correctedBy    Transaction?          @relation("Correction")
  documents      TransactionDocument[]

  @@unique([houseId, idempotencyKey])
  @@unique([houseId, number])
  @@index([houseId, period])
  @@index([accountId, status])
  @@map("transactions")
}

/// Подтверждающий документ операции. Удаление мягкое: изъятие документа из отчётности тоже след
model TransactionDocument {
  id            String       @id @default(uuid(7)) @db.Uuid
  houseId       String       @map("house_id") @db.Uuid
  transactionId String       @map("transaction_id") @db.Uuid
  transaction   Transaction  @relation(fields: [transactionId], references: [id])
  fileId        String       @unique @map("file_id") @db.Uuid
  kind          DocumentKind
  addedBy       String       @map("added_by") @db.Uuid
  addedAt       DateTime     @default(now()) @map("added_at") @db.Timestamptz
  removedBy     String?      @map("removed_by") @db.Uuid
  removedAt     DateTime?    @map("removed_at") @db.Timestamptz

  @@index([transactionId])
  @@map("transaction_documents")
}

// ───────── Фаза 3: начисления (docs/10 §4) ─────────

enum ChargeType {
  MAINTENANCE
  CAPITAL_REPAIR
  PARKING
  TARGETED
  OTHER
}

enum TariffBasis {
  PER_SQM
  FIXED
}

enum ChargeStatus {
  PENDING
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
}

/// Тариф действует с отчётного месяца и до следующего тарифа того же вида. Не правится: новый тариф — новая строка
model Tariff {
  id            String      @id @default(uuid(7)) @db.Uuid
  houseId       String      @map("house_id") @db.Uuid
  house         House       @relation(fields: [houseId], references: [id])
  type          ChargeType
  basis         TariffBasis
  rate          Decimal     @db.Decimal(12, 2)
  /// К каким помещениям применяется: взносы на управление — квартиры и нежилые, парковка — места и кладовки
  unitTypes     UnitType[]  @map("unit_types")
  /// YYYY-MM, включительно
  effectiveFrom String      @map("effective_from") @db.VarChar(7)
  /// YYYY-MM, не включительно; ставится, когда тариф заменён
  effectiveTo   String?     @map("effective_to") @db.VarChar(7)
  /// Основание: «протокол собрания №3 от 12.09.2026»
  decisionNote  String?     @map("decision_note")
  createdBy     String      @map("created_by") @db.Uuid
  createdAt     DateTime    @default(now()) @map("created_at") @db.Timestamptz
  charges       Charge[]

  @@index([houseId, type])
  @@map("tariffs")
}

/// Целевой сбор: решение собрания, а не ежемесячный тариф. Порождает начисления по помещениям
model ChargeCollection {
  id             String      @id @default(uuid(7)) @db.Uuid
  houseId        String      @map("house_id") @db.Uuid
  house          House       @relation(fields: [houseId], references: [id])
  type           ChargeType
  title          String
  basis          TariffBasis
  rate           Decimal     @db.Decimal(12, 2)
  unitTypes      UnitType[]  @map("unit_types")
  period         String      @db.VarChar(7)
  dueDate        DateTime    @map("due_date") @db.Date
  decisionNote   String      @map("decision_note")
  protocolFileId String?     @map("protocol_file_id") @db.Uuid
  createdBy      String      @map("created_by") @db.Uuid
  createdAt      DateTime    @default(now()) @map("created_at") @db.Timestamptz
  charges        Charge[]

  @@index([houseId, period])
  @@map("charge_collections")
}

model Charge {
  id               String            @id @default(uuid(7)) @db.Uuid
  houseId          String            @map("house_id") @db.Uuid
  house            House             @relation(fields: [houseId], references: [id])
  unitId           String            @map("unit_id") @db.Uuid
  unit             Unit              @relation(fields: [unitId], references: [id])
  period           String            @db.VarChar(7)
  type             ChargeType
  title            String
  amount           Decimal           @db.Decimal(12, 2)
  /// Как посчитано: тариф × площадь или фиксированно — жилец видит формулу, а не только сумму
  calculationBasis Json              @map("calculation_basis")
  dueDate          DateTime          @map("due_date") @db.Date
  status           ChargeStatus      @default(PENDING)
  paidAmount       Decimal           @default(0) @map("paid_amount") @db.Decimal(12, 2)
  tariffId         String?           @map("tariff_id") @db.Uuid
  tariff           Tariff?           @relation(fields: [tariffId], references: [id])
  collectionId     String?           @map("collection_id") @db.Uuid
  collection       ChargeCollection? @relation(fields: [collectionId], references: [id])
  /// Ключ уникальности: '' для ежемесячных, id сбора для целевых — в одном месяце может быть несколько сборов
  collectionKey    String            @default("") @map("collection_key") @db.VarChar(36)
  /// null — начислено системой по расписанию
  createdBy        String?           @map("created_by") @db.Uuid
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz
  updatedAt        DateTime          @updatedAt @map("updated_at") @db.Timestamptz
  cancelledAt      DateTime?         @map("cancelled_at") @db.Timestamptz
  cancelledBy      String?           @map("cancelled_by") @db.Uuid
  cancelReason     String?           @map("cancel_reason")
  payments         Payment[]

  @@unique([unitId, period, type, collectionKey])
  @@index([houseId, period])
  @@index([houseId, status])
  @@map("charges")
}

/// Итог начисления дома за месяц: по нему планировщик понимает, что месяц уже начислен
model ChargeRun {
  id           String   @id @default(uuid(7)) @db.Uuid
  houseId      String   @map("house_id") @db.Uuid
  house        House    @relation(fields: [houseId], references: [id])
  period       String   @db.VarChar(7)
  unitsCharged Int      @map("units_charged")
  /// Помещения без площади: по тарифу за м² им нечего начислить, председатель видит список
  unitsSkipped Int      @map("units_skipped")
  total        Decimal  @db.Decimal(14, 2)
  createdBy    String?  @map("created_by") @db.Uuid
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz

  @@unique([houseId, period])
  @@map("charge_runs")
}

// ───────── Фаза 3: оплаты и чеки (docs/10 §5) ─────────

enum ReceiptPurpose {
  EXPENSE
  RESIDENT_PAYMENT
}

enum OcrStatus {
  DONE
  FAILED
  MANUAL
}

enum PaymentMethod {
  KASPI_LINK
  RECEIPT_UPLOAD
  KASPI_API
  CASH
  BANK_TRANSFER
}

enum PaymentStatus {
  PENDING_REVIEW
  CONFIRMED
  REJECTED
  FLAGGED
}

/// Чек как доказательство: распознанные поля и два отпечатка для защиты от повторной подачи
model Receipt {
  id             String         @id @default(uuid(7)) @db.Uuid
  houseId        String         @map("house_id") @db.Uuid
  house          House          @relation(fields: [houseId], references: [id])
  fileId         String         @unique @map("file_id") @db.Uuid
  uploadedBy     String         @map("uploaded_by") @db.Uuid
  purpose        ReceiptPurpose
  ocrStatus      OcrStatus      @map("ocr_status")
  ocrText        String?        @map("ocr_text")
  /// {amount, date, ref, recipient}
  ocrParsed      Json?          @map("ocr_parsed")
  ocrConfidence  Decimal?       @map("ocr_confidence") @db.Decimal(3, 2)
  /// SHA-256 файла: тот же файл ещё раз
  contentHash    Bytes          @map("content_hash")
  /// dHash 64 бита: тот же чек, пересохранённый или переснятый
  perceptualHash Bytes?         @map("perceptual_hash")
  createdAt      DateTime       @default(now()) @map("created_at") @db.Timestamptz
  payments       Payment[]

  @@index([houseId, contentHash])
  @@map("receipts")
}

model Payment {
  id              String        @id @default(uuid(7)) @db.Uuid
  houseId         String        @map("house_id") @db.Uuid
  house           House         @relation(fields: [houseId], references: [id])
  chargeId        String        @map("charge_id") @db.Uuid
  charge          Charge        @relation(fields: [chargeId], references: [id])
  unitId          String        @map("unit_id") @db.Uuid
  paidBy          String        @map("paid_by") @db.Uuid
  /// Сумма, которую заявил плательщик или распознал чек
  amount          Decimal       @db.Decimal(12, 2)
  paidAt          DateTime?     @map("paid_at") @db.Timestamptz
  method          PaymentMethod
  receiptId       String?       @map("receipt_id") @db.Uuid
  receipt         Receipt?      @relation(fields: [receiptId], references: [id])
  /// Номер операции из чека или от банка. Подтверждённым он может быть только один раз — частичный уникальный индекс
  externalRef     String?       @map("external_ref")
  status          PaymentStatus @default(PENDING_REVIEW)
  /// [{code, message}] — что насторожило. Автоматического отказа нет: решает человек
  flags           Json          @default("[]")
  confirmedBy     String?       @map("confirmed_by") @db.Uuid
  confirmedAt     DateTime?     @map("confirmed_at") @db.Timestamptz
  /// Сколько зачтено в начисление — может отличаться от заявленного
  confirmedAmount Decimal?      @map("confirmed_amount") @db.Decimal(12, 2)
  rejectionReason String?       @map("rejection_reason")
  /// Поступление в журнале, созданное подтверждением
  transactionId   String?       @unique @map("transaction_id") @db.Uuid
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz

  @@index([houseId, status])
  @@index([chargeId])
  @@index([externalRef])
  @@map("payments")
}

// ───────── Фаза 3: отчётность (docs/10 §7) ─────────

enum ReportType {
  MONTHLY
  ANNUAL
}

enum ReportStatus {
  DRAFT
  SIGNED
  PUBLISHED
}

/// Форма отчёта как данные: смена приказа — новая строка и effective_from, а не релиз
model ReportTemplate {
  id            String     @id @default(uuid(7)) @db.Uuid
  formCode      String     @map("form_code")
  version       String
  legalSource   String     @map("legal_source")
  effectiveFrom DateTime   @map("effective_from") @db.Date
  effectiveTo   DateTime?  @map("effective_to") @db.Date
  /// Строки формы: код и источник суммы (остаток, долг, сумма операций по кодам, сумма строк)
  schema        Json
  reports       Report[]

  @@unique([formCode, version])
  @@map("report_templates")
}

model Report {
  id                    String         @id @default(uuid(7)) @db.Uuid
  houseId               String         @map("house_id") @db.Uuid
  house                 House          @relation(fields: [houseId], references: [id])
  templateId            String         @map("template_id") @db.Uuid
  template              ReportTemplate @relation(fields: [templateId], references: [id])
  type                  ReportType
  period                String         @db.VarChar(7)
  /// Заполненная форма: шапка и строки с суммами
  data                  Json
  /// Чего не хватает до сдачи: операции без документов, непроведённые черновики
  issues                Json           @default("[]")
  /// Выполненные работы с фото из подтверждённых задач
  workSummary           Json           @default("[]") @map("work_summary")
  /// SHA-256 канонического содержимого: именно его подписывают ЭЦП
  dataHash              Bytes          @map("data_hash")
  status                ReportStatus   @default(DRAFT)
  generatedAt           DateTime       @map("generated_at") @db.Timestamptz
  /// null — сформирован по расписанию
  generatedBy           String?        @map("generated_by") @db.Uuid
  chairmanSignatureId   String?        @map("chairman_signature_id") @db.Uuid
  accountantSignatureId String?        @map("accountant_signature_id") @db.Uuid
  /// Начатые процедуры подписания: {CHAIRMAN: {external_id, user_id}}
  pendingSigning        Json           @default("{}") @map("pending_signing")
  signedAt              DateTime?      @map("signed_at") @db.Timestamptz
  publishedAt           DateTime?      @map("published_at") @db.Timestamptz
  publishedBy           String?        @map("published_by") @db.Uuid
  /// Срок сдачи: 20 число следующего месяца
  dueDate               DateTime       @map("due_date") @db.Date
  createdAt             DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt             DateTime       @updatedAt @map("updated_at") @db.Timestamptz

  @@unique([houseId, type, period])
  @@map("reports")
}

// ───────── Фаза 4: голосования (docs/09) ─────────

enum VoteLegalBasis {
  ART_42_MEETING
  ART_43_WRITTEN_SURVEY
  ART_44_ELECTRONIC
}

enum DecisionType {
  ROUTINE
  CURRENT_REPAIR
  TARIFF_CHANGE
  TARGETED_CONTRIBUTION
  CHAIRMAN_ELECTION
  MAJOR_EXPENSE
  CAPITAL_REPAIR
  MANAGEMENT_CHANGE
  LIQUIDATION
  COMMON_PROPERTY_DISPOSAL
}

enum VoteThreshold {
  SIMPLE_MAJORITY
  TWO_THIRDS
}

enum QuorumBasis {
  BY_AREA
  BY_UNIT
}

enum VoteStatus {
  DRAFT
  NOTICE_SENT
  ACTIVE
  CLOSED
  CANCELLED
}

enum QuestionType {
  YES_NO
  SINGLE_CHOICE
  MULTI_CHOICE
}

enum OptionKind {
  FOR
  AGAINST
  ABSTAIN
  CHOICE
}

enum BallotChannel {
  ELECTRONIC
  PAPER
}

enum ProtocolStatus {
  AWAITING_SIGNATURES
  SIGNED
  PUBLISHED
}

model Vote {
  id                   String         @id @default(uuid(7)) @db.Uuid
  houseId              String         @map("house_id") @db.Uuid
  house                House          @relation(fields: [houseId], references: [id])
  title                String
  description          String?
  legalBasis           VoteLegalBasis @map("legal_basis")
  decisionType         DecisionType   @map("decision_type")
  /// Выводится из типа решения при создании и хранится: смена закона не переписывает прошедшие голосования
  threshold            VoteThreshold
  quorumBasis          QuorumBasis    @default(BY_AREA) @map("quorum_basis")
  resultsVisibleDuring Boolean        @default(false) @map("results_visible_during")
  status               VoteStatus     @default(DRAFT)
  /// Подписывает протокол вместе с председателем
  secretaryUserId      String?        @map("secretary_user_id") @db.Uuid
  noticeSentAt         DateTime?      @map("notice_sent_at") @db.Timestamptz
  startsAt             DateTime?      @map("starts_at") @db.Timestamptz
  endsAt               DateTime?      @map("ends_at") @db.Timestamptz
  activatedAt          DateTime?      @map("activated_at") @db.Timestamptz
  closedAt             DateTime?      @map("closed_at") @db.Timestamptz
  cancelledAt          DateTime?      @map("cancelled_at") @db.Timestamptz
  cancelledBy          String?        @map("cancelled_by") @db.Uuid
  cancelReason         String?        @map("cancel_reason")
  /// Ручное «напомнить непроголосовавшим» — не чаще раза в сутки
  remindedAt           DateTime?      @map("reminded_at") @db.Timestamptz
  createdBy            String         @map("created_by") @db.Uuid
  createdAt            DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt            DateTime       @updatedAt @map("updated_at") @db.Timestamptz

  questions VoteQuestion[]
  snapshot  VoteRegistrySnapshot?
  notices   VoteNotice[]
  signings  BallotSigning[]
  ballots   Ballot[]
  protocol  Protocol?

  @@index([houseId, status])
  @@map("votes")
}

model VoteQuestion {
  id      String       @id @default(uuid(7)) @db.Uuid
  houseId String       @map("house_id") @db.Uuid
  voteId  String       @map("vote_id") @db.Uuid
  vote    Vote         @relation(fields: [voteId], references: [id])
  order   Int
  text    String
  type    QuestionType
  options VoteOption[]

  @@unique([voteId, order])
  @@map("vote_questions")
}

model VoteOption {
  id         String       @id @default(uuid(7)) @db.Uuid
  houseId    String       @map("house_id") @db.Uuid
  questionId String       @map("question_id") @db.Uuid
  question   VoteQuestion @relation(fields: [questionId], references: [id])
  order      Int
  text       String
  kind       OptionKind

  @@unique([questionId, order])
  @@map("vote_options")
}

/// Замороженный реестр на момент старта: веса голосов берутся только отсюда (docs/09 §6)
model VoteRegistrySnapshot {
  id          String   @id @default(uuid(7)) @db.Uuid
  houseId     String   @map("house_id") @db.Uuid
  voteId      String   @unique @map("vote_id") @db.Uuid
  vote        Vote     @relation(fields: [voteId], references: [id])
  totalArea   Decimal  @map("total_area") @db.Decimal(12, 2)
  totalUnits  Int      @map("total_units")
  /// [{unit_id, number, area, weight, voters: [user_id]}]
  entries     Json
  /// SHA-256 канонических entries: снимок проверяем на неизменность при подсчёте и в протоколе
  entriesHash Bytes    @map("entries_hash")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  @@map("vote_registry_snapshots")
}

/// Кому и когда ушло уведомление о собрании: список прикладывается к протоколу
model VoteNotice {
  id          String   @id @default(uuid(7)) @db.Uuid
  houseId     String   @map("house_id") @db.Uuid
  voteId      String   @map("vote_id") @db.Uuid
  vote        Vote     @relation(fields: [voteId], references: [id])
  userId      String   @map("user_id") @db.Uuid
  /// Помещения, собственником которых он подтверждён; пусто — не собственник
  unitNumbers String[] @map("unit_numbers")
  notifiedAt  DateTime @map("notified_at") @db.Timestamptz

  @@unique([voteId, userId])
  @@map("vote_notices")
}

/// Начатое подписание бюллетеня: документ и выбор фиксируются до подписи, бюллетень — только после проверки
model BallotSigning {
  id           String    @id @default(uuid(7)) @db.Uuid
  houseId      String    @map("house_id") @db.Uuid
  voteId       String    @map("vote_id") @db.Uuid
  vote         Vote      @relation(fields: [voteId], references: [id])
  unitId       String    @map("unit_id") @db.Uuid
  userId       String    @map("user_id") @db.Uuid
  provider     String
  externalId   String    @map("external_id")
  document     Json
  documentHash Bytes     @map("document_hash")
  /// [{question_id, option_ids}]
  answers      Json
  expiresAt    DateTime  @map("expires_at") @db.Timestamptz
  createdAt    DateTime  @default(now()) @map("created_at") @db.Timestamptz
  completedAt  DateTime? @map("completed_at") @db.Timestamptz

  @@unique([provider, externalId])
  @@index([voteId, userId])
  @@map("ballot_signings")
}

/// Бюллетень. Append-only: у приложения нет UPDATE и DELETE (docs/09 §8)
model Ballot {
  id           String         @id @default(uuid(7)) @db.Uuid
  houseId      String         @map("house_id") @db.Uuid
  voteId       String         @map("vote_id") @db.Uuid
  vote         Vote           @relation(fields: [voteId], references: [id])
  unitId       String         @map("unit_id") @db.Uuid
  /// Кто подал. У бумажного — собственник из снимка, если известен
  userId       String?        @map("user_id") @db.Uuid
  voterName    String         @map("voter_name")
  channel      BallotChannel
  /// Площадь и доля из снимка. Считаются сервером, из запроса не принимаются
  area         Decimal        @db.Decimal(8, 2)
  weight       Decimal        @db.Decimal(10, 6)
  /// Подписанный документ бюллетеня и его хеш
  document     Json
  documentHash Bytes          @map("document_hash")
  signatureId  String?        @unique @map("signature_id") @db.Uuid
  /// Скан бумажного бюллетеня (ст. 43)
  scanFileId   String?        @map("scan_file_id") @db.Uuid
  /// Бумажный бюллетень внёс председатель — всегда в аудите и в протоколе
  enteredBy    String?        @map("entered_by") @db.Uuid
  castAt       DateTime       @default(now()) @map("cast_at") @db.Timestamptz
  ip           String?
  userAgent    String?        @map("user_agent")
  answers      BallotAnswer[]

  @@unique([voteId, unitId])
  @@map("ballots")
}

model BallotAnswer {
  id         String @id @default(uuid(7)) @db.Uuid
  houseId    String @map("house_id") @db.Uuid
  ballotId   String @map("ballot_id") @db.Uuid
  ballot     Ballot @relation(fields: [ballotId], references: [id])
  questionId String @map("question_id") @db.Uuid
  optionId   String @map("option_id") @db.Uuid

  @@unique([ballotId, optionId])
  @@map("ballot_answers")
}

/// Протокол формируется при закрытии и дальше не меняется: меняются только подписи и публикация
model Protocol {
  id                   String         @id @default(uuid(7)) @db.Uuid
  houseId              String         @map("house_id") @db.Uuid
  voteId               String         @unique @map("vote_id") @db.Uuid
  vote                 Vote           @relation(fields: [voteId], references: [id])
  number               Int
  content              Json
  /// SHA-256 канонического содержимого: его подписывают ЭЦП председатель и секретарь
  contentHash          Bytes          @map("content_hash")
  status               ProtocolStatus @default(AWAITING_SIGNATURES)
  quorumReached        Boolean        @map("quorum_reached")
  quorumPercent        Decimal        @map("quorum_percent") @db.Decimal(5, 2)
  results              Json
  chairmanSignatureId  String?        @map("chairman_signature_id") @db.Uuid
  secretarySignatureId String?        @map("secretary_signature_id") @db.Uuid
  /// {CHAIRMAN: {external_id, user_id}, SECRETARY: {...}}
  pendingSigning       Json           @default("{}") @map("pending_signing")
  signedAt             DateTime?      @map("signed_at") @db.Timestamptz
  publishedAt          DateTime?      @map("published_at") @db.Timestamptz
  publishedBy          String?        @map("published_by") @db.Uuid
  /// Хранить не менее 5 лет (docs/09 §7)
  retentionUntil       DateTime       @map("retention_until") @db.Date
  createdAt            DateTime       @default(now()) @map("created_at") @db.Timestamptz
  updatedAt            DateTime       @updatedAt @map("updated_at") @db.Timestamptz

  @@unique([houseId, number])
  @@map("protocols")
}
