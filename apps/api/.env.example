# Скопировать в .env. В продакшене значения приходят из секрет-хранилища, не из файла.
NODE_ENV=development
PORT=3000
# Приложение работает под ролью без BYPASSRLS
DATABASE_URL=postgresql://ortaq_app:ortaq_app@localhost:5442/ortaq
# Миграции и сид — под ролью-владельцем схемы
MIGRATE_DATABASE_URL=postgresql://ortaq:ortaq@localhost:5442/ortaq
WEB_ORIGIN=http://localhost:5174
# Секреты: не короче 32 байт, генерировать `openssl rand -base64 32`
JWT_SECRET=change-me
# AES-256-GCM для TOTP-секретов и ИИН: ровно 32 байта в base64
ENCRYPTION_KEY=change-me
# HMAC для хеширования ИИН и токенов
HMAC_KEY=change-me
SMTP_URL=smtp://localhost:1035
MAIL_FROM="Ortaq <no-reply@ortaq.local>"
# hibp — проверка паролей по базе утёкших (k-anonymity), off — без проверки
PASSWORD_BREACH_CHECK=hibp
# Первый админ платформы, создаётся сидом
SEED_ADMIN_EMAIL=admin@ortaq.local
SEED_ADMIN_PASSWORD=change-me-long-password

# Подпись ЭЦП: dev — заглушка SIGEX (только разработка), sigex — настоящий провайдер
SIGNATURE_PROVIDER=dev

# Объектное хранилище (S3). В разработке — SeaweedFS из docker-compose, ключи из infra/seaweedfs/s3.json
S3_ENDPOINT=http://localhost:8343
S3_PUBLIC_ENDPOINT=http://localhost:8343
S3_BUCKET=ortaq
S3_ACCESS_KEY=ortaq-dev
S3_SECRET_KEY=ortaq-dev-secret
