# Локальная разработка. Скопировать в .env: cp .env.example .env
NODE_ENV=development
PORT=3000
DATABASE_MIGRATOR_URL=postgresql://migrator:migrator@localhost:5432/ortaq
DATABASE_URL=postgresql://app_rw:app_rw@localhost:5432/ortaq
DATABASE_ADMIN_URL=postgresql://app_admin:app_admin@localhost:5432/ortaq
# Ключи генерируются: node scripts/gen-keys.mjs >> .env (base64, 32 байта)
JWT_SECRET=
IIN_ENCRYPTION_KEY=
IIN_HMAC_KEY=
TOTP_ENCRYPTION_KEY=
WEB_ORIGIN=http://localhost:5173
ADMIN_ORIGIN=http://localhost:5173
PUBLIC_WEB_URL=http://localhost:5173
# Интеграции: mock | real. На этапе разработки — mock.
MAIL_PROVIDER=mock
SMTP_URL=smtp://localhost:1025
SIGNATURE_PROVIDER=mock
IDENTITY_PROVIDER=mock
PROPERTY_REGISTRY_PROVIDER=mock
RATE_LIMIT_ENABLED=true
COOKIE_SECURE=false
